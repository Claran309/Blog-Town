---
import TownBlogApp from '../components/TownBlogApp';
import { siteConfig } from '../config/site';
import { analyticsConfig } from '../config/analytics';
import type { TownLayout } from '../data/town-layout';
import type { TownPostSummary } from '../components/TownScene';
import type { ArticleSection } from '../lib/markdown';
import { buildPageJsonLd } from '../lib/page-jsonld';
import '../styles/global.css';
import '../styles/markdown.css';

interface Props {
  posts: TownPostSummary[];
  layout?: TownLayout;
  initialSurface: 'town' | 'archive' | 'article' | 'about' | 'diary';
  initialPostId?: string;
  initialPostContent?: ArticleSection[];
}

const { posts, layout, initialSurface, initialPostId, initialPostContent } = Astro.props;
const selectedPost = initialPostId ? posts.find((post) => post.id === initialPostId) : undefined;
const pageTitle = selectedPost
  ? `${selectedPost.title} · ${siteConfig.title}`
  : initialSurface === 'archive' ? `全部文章 · ${siteConfig.title}`
    : initialSurface === 'diary' ? `短日记 · ${siteConfig.title}`
      : initialSurface === 'about' ? `关于我 · ${siteConfig.title}`
        : siteConfig.title;
const description = selectedPost?.description ?? siteConfig.description;
const canonical = selectedPost
  ? new URL(`/posts/${encodeURIComponent(selectedPost.id)}/`, siteConfig.siteUrl)
  : new URL(initialSurface === 'archive' ? '/posts/' : initialSurface === 'diary' ? '/diary/' : initialSurface === 'about' ? '/about/' : '/', siteConfig.siteUrl);
const cover = selectedPost?.cover ? new URL(selectedPost.cover, siteConfig.siteUrl) : new URL(siteConfig.logo, siteConfig.siteUrl);
const jsonLdText = JSON.stringify(buildPageJsonLd(selectedPost)).replace(/</g, '\\u003c');
---
<html lang={siteConfig.language} data-initial-surface={initialSurface}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Apply before the first paint; React continues following the same preference.
      const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('mode-night', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#0b1220' : '#ffffff');
    </script>
    {analyticsConfig.enabled && <script is:inline define:vars={{ gtmId: analyticsConfig.gtmId, clarityId: analyticsConfig.clarityId, allowedHosts: analyticsConfig.allowedHosts }}>
      window.dataLayer = window.dataLayer || [];
      window.clarity = window.clarity || function () {
        (window.clarity.q = window.clarity.q || []).push(arguments);
      };

      function loadAnalytics() {
        if (!allowedHosts.includes(window.location.hostname)) return;

        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const first = d.getElementsByTagName(s)[0];
          const script = d.createElement(s);
          const layer = l !== 'dataLayer' ? '&l=' + l : '';
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + layer;
          first.parentNode.insertBefore(script, first);
        })(window, document, 'script', 'dataLayer', gtmId);

        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clarityId);
      }

      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadAnalytics, { timeout: 3000 });
      } else {
        window.setTimeout(loadAnalytics, 3000);
      }
    </script>}
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.profile.name} />
    <meta property="og:type" content={selectedPost ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cover} />
    <meta property="og:image:alt" content={selectedPost?.coverAlt ?? siteConfig.title} />
    {selectedPost && <meta property="article:published_time" content={selectedPost.date} />}
    {selectedPost && <meta property="article:modified_time" content={selectedPost.updatedAt ?? selectedPost.date} />}
    {selectedPost && <meta property="article:section" content={selectedPost.category} />}
    {selectedPost?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cover} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} · RSS`} href={new URL('/rss.xml', siteConfig.siteUrl)} />
    <link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', siteConfig.siteUrl)} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{pageTitle}</title>
    <script id="page-jsonld" is:inline type="application/ld+json" set:html={jsonLdText}></script>
    {initialSurface === 'town' && <link rel="preload" href="/assets/brick-town/studio.env" as="fetch" crossorigin="anonymous" />}
    <script>
      import '../scripts/town-startup';
    </script>
  </head>
  <body>
    {analyticsConfig.enabled && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${analyticsConfig.gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager" /></noscript>}
    <TownBlogApp client:load posts={posts} layout={layout} initialSurface={initialSurface} initialPostId={initialPostId} initialPostContent={initialPostContent} />
  </body>
</html>
